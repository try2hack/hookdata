# Copy to .env (git-ignored) and fill in real values, or set these as real
# environment variables in your web server / container.
# Environment variables take precedence over config.php.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=test_hook
DB_USER=hook_user
DB_PASS=change-me

# --- Decrypt service ---
# Must contain the token {data} (replaced by the url-encoded value) or end with "/".
DECRYPT_API_URL=https://example.com/decrypted/{data}
DECRYPT_TIMEOUT=5
# true = skip the decrypt call and use the raw value as-is (testing only)
DECRYPT_PASSTHROUGH=false

# --- Webhook auth (hook.php) ---
# Shared secret for the X-Webhook-Secret header and the HMAC key for X-Signature.
# Leave empty to disable auth (NOT recommended).
WEBHOOK_SECRET=generate-a-long-random-string

# --- Viewer auth (view.php, HTTP Basic) ---
VIEWER_USER=admin
# Generate: php -r "echo password_hash('your-password', PASSWORD_DEFAULT), PHP_EOL;"
VIEWER_PASS_HASH=
